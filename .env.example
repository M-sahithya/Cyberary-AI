# ============================================
# Cyberary-AI Environment Configuration
# ============================================
# Copy this file to .env and update values.
# NEVER commit the .env file to version control.
# ============================================

# --- Application ---
APP_ENV=development
APP_NAME=Cyberary-AI
APP_VERSION=1.0.0
LAB_MODE=true

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cyberary
POSTGRES_USER=cyberary_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://cyberary_user:change_me_in_production@postgres:5432/cyberary

# --- MongoDB ---
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=cyberary_logs
MONGO_USER=cyberary_mongo
MONGO_PASSWORD=change_me_in_production
MONGODB_URL=mongodb://cyberary_mongo:change_me_in_production@mongodb:27017/cyberary_logs?authSource=admin

# --- JWT ---
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_SECRET_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# --- LLM / AI ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3
OLLAMA_BASE_URL=http://ollama:11434
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# --- NVD API ---
NVD_API_KEY=
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# --- Honeypot (Cowrie) ---
COWRIE_HOST=honeypot
COWRIE_PORT=2222
COWRIE_LOG_PATH=/var/log/cowrie

# --- Wazuh (Optional) ---
WAZUH_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=

# --- Rate Limiting ---
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_API=60/minute

# --- Default Admin (for seed script only) ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CyberaryAdmin123!
DEFAULT_ADMIN_EMAIL=admin@cyberary.local
